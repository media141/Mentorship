# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.
# Both are safe to ship to the browser: access is enforced by Row Level
# Security policies (see ../supabase/schema.sql), not by keeping this secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
